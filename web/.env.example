# Leave empty for root deploys (Vercel, Netlify, username.github.io, custom domain).
# For GitHub project Pages use the repo name, e.g. /website-exploration
NEXT_PUBLIC_BASE_PATH=

# Optional: remote chat API that accepts POST { messages } and returns
# { text, openProjectId?, openProjectTitle? }. Without this, chat uses
# the built-in offline knowledge base (works on static hosts).
# NEXT_PUBLIC_CHAT_API_URL=

# Optional Spline scene URL for the 3D mascot (otherwise SVG capybara).
# NEXT_PUBLIC_SPLINE_SCENE=
